# Supabase
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Database
# Preferred: Supabase Local (Postgres port is configured in supabase/config.toml)
DATABASE_URL="postgresql://postgres:postgres@localhost:54332/postgres?schema=public"
# Fallback: standalone local Postgres via docker-compose.yml
# DATABASE_URL="postgresql://uconnect:uconnect@localhost:5432/uconnect?schema=public"

# API
API_PORT=4000
# Optional. Comma-separated browser origins for CORS. In development, if unset, any
# http(s) origin on localhost / 127.0.0.1 / [::1] is allowed. In production, set this to your real web origins.
# API_CORS_ORIGINS="https://app.example.com"
SUPABASE_JWT_SECRET="" # optional; prefer service-role validation in apps/api
