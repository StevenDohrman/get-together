generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
  // Connection is configured via prisma.config.ts
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum SwipeDecision {
  YES
  NO
}

enum GroupFormationStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum FormationInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Interest {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  metadata  Json?
  isRoot    Boolean  @default(false) @map("is_root")
  createdAt DateTime @default(now())

  // Relations to represent a Directed Acyclic Graph (DAG)
  parents  InterestRelation[] @relation("child_relations")
  children InterestRelation[] @relation("parent_relations")

  users  UserInterest[]
  groups GroupInterest[]
  userGroupSeekingInterests UserGroupSeekingInterest[]

  embedding InterestEmbedding?
}

// Join table for self-referential many-to-many to model DAG edges
model InterestRelation {
  parent   Interest @relation("parent_relations", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String   @db.Uuid @map("parent_id")
  child    Interest @relation("child_relations", fields: [childId], references: [id], onDelete: Cascade)
  childId  String   @db.Uuid @map("child_id")

  // Optional weight or ordering for the relation
  weight Int? @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at")

  @@id([parentId, childId])
  @@index([childId])
}

model InterestEmbedding {
  id         String   @id @default(uuid()) @db.Uuid
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId String                   @db.Uuid @unique @map("interest_id")
  vector     Unsupported("vector(768)")
  model      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([interestId])
}

model User {
  id             String  @id @default(uuid()) @db.Uuid
  /// Supabase Auth user id (`sub` / `auth.users.id`); links app profile to the signed-in account.
  supabaseAuthId String? @unique @map("supabase_auth_id") @db.Uuid
  email          String  @unique
  /// Unique handle for mentions, URLs, etc. Enforced in the database.
  username       String? @unique
  /// Human-facing name; not required to be unique.
  displayName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  interests UserInterest[]

  swipesInitiated UserSwipe[] @relation("SwipesInitiated")
  swipesReceived  UserSwipe[] @relation("SwipesReceived")

  groupSeekings UserGroupSeeking[]

  formationProposalsAnchored GroupFormationProposal[] @relation("FormationAnchor")
  formationInvites           GroupFormationInvite[]

  createdGroups    Group[]         @relation("GroupCreatedBy")
  groupMemberships GroupMember[]
  createdEvents    Event[]         @relation("EventCreatedBy")
  eventAttendances EventAttendee[]
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?

  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String   @db.Uuid

  members   GroupMember[]
  interests GroupInterest[]
  events    Event[]
  formationOrigin GroupFormationProposal? @relation("FormationToGroup")

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([createdById])
}

model UserInterest {
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String   @db.Uuid
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId String   @db.Uuid

  // Importance of this interest for the user. Convention: 1-10.
  weight Int @default(5) @db.SmallInt
  createdAt DateTime @default(now())

  @@id([userId, interestId])
  @@index([interestId])
}

/// A swipe on another user (yes/no). Used for mutual-match discovery separate from group-seeking interests.
model UserSwipe {
  swiper   User @relation("SwipesInitiated", fields: [swiperId], references: [id], onDelete: Cascade)
  swiperId String @db.Uuid
  target   User @relation("SwipesReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId String @db.Uuid

  decision SwipeDecision
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([swiperId, targetUserId])
  @@index([targetUserId])
}

/// A template for the kind of group this user wants to join or form (max 10 per user enforced in API).
model UserGroupSeeking {
  id     String @id @default(uuid()) @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  /// Final headcount for the group, including this user.
  targetGroupSize Int @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interests  UserGroupSeekingInterest[]
  proposals  GroupFormationProposal[]

  @@index([userId])
}

model UserGroupSeekingInterest {
  userGroupSeeking   UserGroupSeeking @relation(fields: [userGroupSeekingId], references: [id], onDelete: Cascade)
  userGroupSeekingId String           @db.Uuid
  interest           Interest         @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId         String           @db.Uuid

  @@id([userGroupSeekingId, interestId])
  @@index([interestId])
}

/// A pending or completed offer to assemble a real Group from compatible mutual swipes + group seekings.
model GroupFormationProposal {
  id String @id @default(uuid()) @db.Uuid

  anchorUserId String @db.Uuid
  anchorUser   User   @relation("FormationAnchor", fields: [anchorUserId], references: [id], onDelete: Cascade)

  userGroupSeekingId String           @db.Uuid
  userGroupSeeking   UserGroupSeeking @relation(fields: [userGroupSeekingId], references: [id], onDelete: Cascade)

  status GroupFormationStatus @default(OPEN)

  formedGroupId String? @unique @db.Uuid
  formedGroup   Group?  @relation("FormationToGroup", fields: [formedGroupId], references: [id], onDelete: SetNull)

  invites GroupFormationInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anchorUserId])
  @@index([status])
}

model GroupFormationInvite {
  id String @id @default(uuid()) @db.Uuid

  proposalId String                 @db.Uuid
  proposal   GroupFormationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status FormationInviteStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proposalId, userId])
  @@index([userId])
  @@index([proposalId])
}

model GroupInterest {
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String   @db.Uuid
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId String   @db.Uuid

  // How strongly this group is associated with an interest. Convention: 1-10.
  weight Int @default(5) @db.SmallInt
  createdAt DateTime @default(now())

  @@id([groupId, interestId])
  @@index([interestId])
}

model GroupMember {
  group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String    @db.Uuid
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String    @db.Uuid
  role    GroupRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  description String?

  startsAt  DateTime
  endsAt    DateTime?

  locationName    String?
  locationAddress String?

  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @db.Uuid

  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId String? @db.Uuid

  attendees EventAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([createdById])
  @@index([groupId])
}

model EventAttendee {
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String     @db.Uuid
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String     @db.Uuid
  status  RSVPStatus @default(GOING)
  createdAt DateTime @default(now())

  @@id([eventId, userId])
  @@index([userId])
}
