generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection is configured via prisma.config.ts
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model Interest {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  users  UserInterest[]
  groups GroupInterest[]
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interests UserInterest[]

  createdGroups    Group[]         @relation("GroupCreatedBy")
  groupMemberships GroupMember[]
  createdEvents    Event[]         @relation("EventCreatedBy")
  eventAttendances EventAttendee[]
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?

  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String   @db.Uuid

  members   GroupMember[]
  interests GroupInterest[]
  events    Event[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([createdById])
}

model UserInterest {
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String   @db.Uuid
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId String   @db.Uuid

  // Importance of this interest for the user. Convention: 1-10.
  weight Int @default(5) @db.SmallInt
  createdAt DateTime @default(now())

  @@id([userId, interestId])
  @@index([interestId])
}

model GroupInterest {
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String   @db.Uuid
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId String   @db.Uuid

  // How strongly this group is associated with an interest. Convention: 1-10.
  weight Int @default(5) @db.SmallInt
  createdAt DateTime @default(now())

  @@id([groupId, interestId])
  @@index([interestId])
}

model GroupMember {
  group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String    @db.Uuid
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String    @db.Uuid
  role    GroupRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  description String?

  startsAt  DateTime
  endsAt    DateTime?

  locationName    String?
  locationAddress String?

  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @db.Uuid

  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId String? @db.Uuid

  attendees EventAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([createdById])
  @@index([groupId])
}

model EventAttendee {
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String     @db.Uuid
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String     @db.Uuid
  status  RSVPStatus @default(GOING)
  createdAt DateTime @default(now())

  @@id([eventId, userId])
  @@index([userId])
}
